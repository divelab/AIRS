# Copy to `.env` and edit for your machine.
#   cp .env.example .env

# Absolute path to this repository
PROJECT_ROOT=/path/to/OrbFlow

# Root for prepared datasets (LMDB, GT sidecars, datasplits, MD trees).
# Layout is documented in docs/DATA.md.
DATAPATH=/path/to/orbflow_data

# Optional
# CONDA_ENV=orbflow
# WANDB_MODE=online
